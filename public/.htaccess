# Make4Web Mail — Apache front controller
Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Phones and Thunderbird sign in to /dav/ with HTTP Basic: hand the header to PHP (CGI / FPM).
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
    <FilesMatch "\.(css|js|woff2|svg|png|ico|webmanifest)$">
        Header set Cache-Control "public, max-age=2592000"
        Header set Cross-Origin-Resource-Policy "same-origin"
        Header set Content-Security-Policy "default-src 'none'; connect-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; frame-ancestors 'none'"
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    <Files "sw.js">
        Header set Cache-Control "no-cache"
    </Files>
</IfModule>

<FilesMatch "\.(php|phtml)$">
    Require all denied
</FilesMatch>
<Files "index.php">
    Require all granted
</Files>
